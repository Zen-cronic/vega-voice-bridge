    { "name": "final without text", "frame": "{\"type\":\"transcript.final\",\"utteranceId\":\"u\"}" },
    { "name": "a hop's at not a number", "frame": "{\"type\":\"transcript.final\",\"utteranceId\":\"u\",\"text\":\"x\",\"hops\":[{\"hop\":\"a\",\"at\":\"1\"}]}", "error": "hops entries" },
    { "name": "a null hop", "frame": "{\"type\":\"transcript.final\",\"utteranceId\":\"u\",\"text\":\"x\",\"hops\":[null]}", "error": "hops entries" },
    { "name": "hops not an array", "frame": "{\"type\":\"ack\",\"utteranceId\":\"u\",\"hops\":\"x\"}" },
    { "name": "unknown ack stage", "frame": "{\"type\":\"ack\",\"utteranceId\":\"u\",\"stage\":\"done\",\"hops\":[]}" },
    { "name": "ok not a boolean", "frame": "{\"type\":\"intent\",\"utteranceId\":\"u\",\"name\":\"n\",\"ok\":\"yes\",\"payload\":1,\"hops\":[]}" },
    { "name": "app without topic", "frame": "{\"type\":\"app\",\"payload\":1}" },
    { "name": "topic not a string", "frame": "{\"type\":\"app\",\"topic\":5,\"payload\":1}", "error": "app.topic must be a string" },
    { "name": "t0 null", "frame": "{\"type\":\"ping\",\"t0\":null}" },
    { "name": "t0 not a number", "frame": "{\"type\":\"ping\",\"t0\":\"now\"}", "error": "ping.t0 must be a finite number" }
  ],
  "normalized": [
    { "name": "a null optional field is dropped", "frame": "{\"type\":\"hello\",\"v\":1,\"role\":\"mic\",\"clientId\":\"m\",\"code\":\"K7QF\",\"name\":null}", "decoded": { "type": "hello", "v": 1, "role": "mic", "clientId": "m", "code": "K7QF" } },
    { "name": "missing hops read as []", "frame": "{\"type\":\"transcript.final\",\"utteranceId\":\"u\",\"text\":\"x\"}", "decoded": { "type": "transcript.final", "utteranceId": "u", "text": "x", "hops": [] } }

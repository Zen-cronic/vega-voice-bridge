{
  "name": "tv-voice-bridge",
  "version": "0.3.1",
  "private": true,
  "description": "A voice back-and-forth harness for TV apps and agents: the phone listens, your app or agent answers, the TV shows it and says it, and playback is confirmed. A small WebSocket protocol, a hub and a client with per-hop latency stamps. Built for Fire TV (Vega OS), which has no app-level speech-to-text API.",
  "license": "MIT",
  "author": "Kaung Zin Hein",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "tv-voice-bridge-hub": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "source": "./src/client.ts",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./hub": {
      "source": "./src/hub.ts",
      "types": "./dist/hub.d.ts",
      "default": "./dist/hub.js"
    },
    "./phone": {
      "source": "./src/phone.ts",
      "types": "./dist/phone.d.ts",
      "default": "./dist/phone.js"
    },
    "./protocol": {
      "source": "./src/protocol.ts",
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./serve": {
      "source": "./src/serve.ts",
      "types": "./dist/serve.d.ts",
      "default": "./dist/serve.js"
    },
    "./qr": {
      "source": "./src/qr.ts",
      "types": "./dist/qr.d.ts",
      "default": "./dist/qr.js"
    },
    "./react": {
      "source": "./src/react.ts",
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./vega": {
      "source": "./src/vega.ts",
      "types": "./dist/vega.d.ts",
      "default": "./dist/vega.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "examples/minimal-phone/phone.html",
    "README.md",
    "PROTOCOL.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "example": "npm run build --silent && node examples/loop/loop.mjs",
    "hub": "npm run build --silent && node dist/cli.js",
    "clean": "rm -rf dist *.tgz",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "fire-tv",
    "vega",
    "react-native",
    "tv",
    "voice",
    "microphone",
    "websocket",
    "companion-app",
    "10-foot",
    "agent",
    "voice-agent",
    "speech"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-native": "*",
    "ws": "^8",
    "@amazon-devices/react-native-w3cmedia": ">=2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "ws": {
      "optional": true
    },
    "@amazon-devices/react-native-w3cmedia": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-test-renderer": "^18.3.1",
    "@types/ws": "^8.18.2",
    "jsqr": "^1.4.0",
    "react": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.9.0",
    "vitest": "^5.0.4",
    "ws": "^8.22.0"
  }
}
